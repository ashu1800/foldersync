{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderSync",
  "version": "0.2.4",
  "identifier": "com.foldersync.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FolderSync",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0QzJGQkQ2Q0Q5QjJGMzAKUldRd0w1dk4xdnZDNUZTTitQQTdMOElXRmhnKzVnYWhHeHpuek4xQzJnR09TQllxelN5RitIakwK",
      "endpoints": [
        "https://github.com/ashu1800/foldersync/releases/latest/download/latest.json"
      ]
    }
  }
}
